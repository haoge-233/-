# 本地环境变量模板。复制为 local-env.sh 并填入真实密钥后使用：
#   cp local-env.sh.example local-env.sh
#   source ./local-env.sh
# local-env.sh 已被 .gitignore 排除，切勿把明文密钥写回 application.yml。

# 必填：对话模型（基元律动 TokenRhythm，OpenAI 兼容网关）
export TOKENRHYTHM_API_KEY="sk_tr_你的密钥"

# 必填：向量模型（阿里云百炼 DashScope）
# 注意：该密钥必须属于已开通 embedding 模型的业务空间。
# 用错空间时接口返回 403 Model.AccessDenied，与额度无关。
export DASHSCOPE_API_KEY="sk-你的密钥"

# 可选：对话模型，默认 glm-5.3
# export TOKENRHYTHM_MODEL="glm-5.3"

# 可选：/api/ai_ops 专用模型。必须是高速模型——该接口走阻塞式调用，
# 网关对非流式请求约 60s 超时，慢模型会导致整个流程失败。默认 deepseek-v4-flash。
# export TOKENRHYTHM_OPS_MODEL="deepseek-v4-flash"

# 可选：对外暴露服务前，必须先设置鉴权令牌
# export SERVER_ADDRESS="0.0.0.0"
# export SERVER_AUTH_TOKEN="换成一个随机长字符串"
# export SERVER_CORS_ALLOWED_ORIGINS="https://your-frontend.example.com"

# 可选：接入真实 Prometheus / 腾讯云日志后再关闭模拟
# export PROMETHEUS_MOCK_ENABLED="false"
# export CLS_MOCK_ENABLED="false"
